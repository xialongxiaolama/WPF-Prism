<UserControl x:Class="WpfPrism_Demo.Views.ViewC"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPrism_Demo.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <TextBlock Style="{StaticResource Title}">ViewC-对话框服务</TextBlock>
        <TextBlock Style="{StaticResource Subtitle}">练习: IDialogService.ShowDialog + IDialogResult 回调</TextBlock>
        <WrapPanel Margin="0,20,0,10">
            <Label>对话框标题</Label>
            <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding DialogTitle}"></TextBox>
        </WrapPanel>
        <WrapPanel Margin="0,10">
            <Label>对话框参数</Label>
            <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding DialogInput}"></TextBox>
        </WrapPanel>
        <Button Margin="0,20,0,0" Width="100" HorizontalAlignment="Left" Command="{Binding OpenDialogCommand}">打开对话框</Button>
        <Separator Margin="0,30"></Separator>
        <TextBlock>对话框返回的结果:</TextBlock>
        <TextBlock Text="{Binding DialogResult}" Foreground="#ca416e" Margin="0,10"/>
    </StackPanel>
</UserControl>
