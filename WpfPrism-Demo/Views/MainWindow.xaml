<Window x:Class="WpfPrism_Demo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPrism_Demo"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:viewModels="clr-namespace:WpfPrism_Demo.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900">

    <Window.Resources>
        <!-- 导航按钮样式：通过 DataTrigger 根据 IsDynamic 切换文字颜色 -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <!-- 动态导航项（模块加载后添加的）用浅蓝色文字区分 -->
                <DataTrigger Binding="{Binding IsDynamic}" Value="True">
                    <Setter Property="Foreground" Value="#4FC3F7"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!--左边导航栏：改为 ItemsControl 数据驱动，支持动态添加/移除模块入口-->
        <Border Background="#2d2d30" DockPanel.Dock="Left" Width="180">
            <DockPanel>
                <!-- 标题 -->
                <TextBlock Text="Prism 8 Demo" TextAlignment="Center" Foreground="White"
                           FontWeight="Bold" FontSize="16" Margin="0,20,0,12"
                           DockPanel.Dock="Top"/>

                <!-- 分割线 -->
                <Rectangle Height="1" Fill="#444" Margin="12,0" DockPanel.Dock="Top"/>

                <!--
                    导航项列表。
                    ItemsControl 绑定 NavItems 集合，集合变化时 UI 自动刷新。
                    ItemTemplate 根据 IsDynamic 属性选择不同的按钮样式。
                -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:NavItemViewModel}">
                                <Button Content="{Binding DisplayName}"
                                        Style="{StaticResource NavButton}"
                                        Command="{Binding NavigateCommand}"
                                        CommandParameter="{Binding ViewName}">
                                    <!-- 可见性绑定：模块卸载时 IsVisible=false，按钮隐藏 -->
                                    <Button.Visibility>
                                        <Binding Path="IsVisible">
                                            <Binding.Converter>
                                                <BooleanToVisibilityConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Button.Visibility>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!--右侧内容区域-->
        <ContentControl Padding="20" DockPanel.Dock="Right" prism:RegionManager.RegionName="ContentRegion">
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </ContentControl.Template>
        </ContentControl>
    </DockPanel>
</Window>
