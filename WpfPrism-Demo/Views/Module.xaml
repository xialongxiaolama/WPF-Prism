<UserControl x:Class="WpfPrism_Demo.Views.Module"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfPrism_Demo.Views"
             xmlns:viewModels="clr-namespace:WpfPrism_Demo.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 卡片样式：圆角边框 + 阴影 -->
        <Style x:Key="ModuleCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="8" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态标签样式 -->
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- 按钮通用样式 -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="模块化管理" FontSize="22" FontWeight="Bold" Foreground="#2D2D30"/>
            <TextBlock Text="点击卡片上的按钮加载或卸载模块，加载后左侧导航栏会自动出现对应入口"
                       FontSize="13" Foreground="#888" Margin="0,4,0,0"/>
        </StackPanel>

        <!--
            模块卡片列表。
            ItemsControl 是 WPF 中展示集合的轻量级控件（不像 ListBox 自带选中项）。
            - ItemsSource 绑定 Modules 集合
            - ItemsPanel 指定用 WrapPanel 布局，卡片自动换行
            - ItemTemplate 定义每个卡片的外观
        -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ModuleItemViewModel}">
                        <Border Style="{StaticResource ModuleCard}">
                            <StackPanel>
                                <!-- 卡片头部：名称 + 状态标签 -->
                                <DockPanel LastChildFill="True">
                                    <!-- 状态标签：根据 State 切换颜色和文字 -->
                                    <Border DockPanel.Dock="Right">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StateBadge}">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Loaded">
                                                        <Setter Property="Background" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Loading">
                                                        <Setter Property="Background" Value="#FF9800"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>

                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold"
                                               Foreground="#2D2D30" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- 模块详细信息 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontSize="12" Foreground="#666">
                                        <Run Text="模块名: "/><Run Text="{Binding ModuleName,Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#666" Margin="0,2,0,0">
                                        <Run Text="类型: "/><Run Text="{Binding ModuleType,Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#666" Margin="0,2,0,0">
                                        <Run Text="加载时机: "/><Run Text="{Binding InitializationMode,Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#666" Margin="0,2,0,0">
                                        <Run Text="导航视图: "/><Run Text="{Binding NavigationViewName,Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 分割线 -->
                                <Rectangle Height="1" Fill="#EEE" Margin="0,12,0,12"/>

                                <!-- 操作按钮区 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- 卸载按钮：仅在已加载时可用 -->
                                    <Button Content="卸载"
                                            Command="{Binding UnloadCommand}"
                                            Margin="0,0,8,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                                                <Setter Property="Background" Value="#F44336"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 加载按钮：仅在未加载时可用 -->
                                    <Button Content="加载"
                                            Command="{Binding LoadCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                                                <Setter Property="Background" Value="#2196F3"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
