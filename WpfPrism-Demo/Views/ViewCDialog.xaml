<UserControl x:Class="WpfPrism_Demo.Views.ViewCDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfPrism_Demo.Views"
             xmlns:prism="http://prismlibrary.com/"
             >
    <!--封装对话框内容, Prism 的DialogService 会自动把它装进默认的宿主对话框IDialog 中-->
    <StackPanel Margin="20" MinWidth="300">
        <TextBlock>调用者传递的信息:</TextBlock>
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" FontSize="14" Foreground="#555" Margin="0,0,0,16"/>

        <TextBlock Text="请输入内容：" FontWeight="Bold"/>
        <TextBox Padding="4,3" Margin="0,6,0,20"
                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Command="{Binding OkCommand}" Padding="18,7" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="18,7" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</UserControl>
